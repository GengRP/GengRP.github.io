---
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
}
const { title, href, linkLabel } = Astro.props;
---

<div class="mb-5 flex items-baseline justify-between gap-4 border-b border-rule pb-2">
  <h2 class="font-display text-sm font-semibold tracking-wide text-faint uppercase">{title}</h2>
  {
    href && (
      <a href={href} class="tap text-sm text-muted transition-colors duration-200 hover:text-accent">
        {linkLabel} →
      </a>
    )
  }
</div>
