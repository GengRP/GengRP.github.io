---
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
}
const { title, href, linkLabel } = Astro.props;
---

<div class="mb-8 flex flex-wrap items-end justify-between gap-x-6 gap-y-2 sm:mb-10">
  <h2 class="display text-3xl sm:text-[2.5rem]">{title}</h2>
  {
    href && (
      <a href={href} class="tap text-[0.9375rem] text-accent hover:underline underline-offset-4">
        {linkLabel} <span aria-hidden="true">›</span>
      </a>
    )
  }
</div>
