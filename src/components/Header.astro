---
import { ui, LANGS, LANG_LABEL, HTML_LANG, DAILY_PATH, path, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  slug?: string;
}

const { lang, slug = '' } = Astro.props;
const t = ui[lang];
const current = Astro.url.pathname;

const items = [
  { label: t.nav.writing, href: path(lang, 'writing') },
  { label: t.nav.posts, href: path(lang, 'posts') },
  { label: t.nav.daily, href: DAILY_PATH[lang] },
  { label: t.nav.projects, href: path(lang, 'projects') },
  { label: t.nav.toolbox, href: path(lang, 'toolbox') },
  { label: t.nav.shelf, href: path(lang, 'shelf') },
  { label: t.nav.about, href: path(lang, 'about') },
];

const isActive = (href: string) => current.startsWith(href);
---

<header class="glass sticky top-0 z-30 border-b border-black/10">
  <div class="wrap flex h-12 items-center justify-between gap-x-6">
    <a
      href={path(lang)}
      class="tap font-display text-[1.0625rem] font-semibold tracking-tight text-ink transition-opacity duration-200 hover:opacity-70"
    >
      KOUHEI<span class="gradient-text"> AI</span>
    </a>

    <div class="flex items-center gap-5">
      <ul class="hidden items-center gap-6 text-[0.8125rem] sm:flex" aria-label={t.menu}>
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'tap transition-colors duration-200 hover:text-ink',
                  isActive(item.href) ? 'text-ink' : 'text-ink/70',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Segmented control for language. -->
      <ul class="flex items-center rounded-full bg-black/[0.06] p-0.5 text-xs font-medium" aria-label={t.langs}>
        {
          LANGS.map((l) => (
            <li>
              <a
                href={path(l, slug)}
                hreflang={HTML_LANG[l]}
                lang={HTML_LANG[l]}
                aria-current={l === lang ? 'true' : undefined}
                class:list={[
                  'tap flex min-w-8 justify-center rounded-full px-2 py-1 transition-colors duration-200',
                  l === lang ? 'bg-white text-ink shadow-[0_1px_3px_rgb(0_0_0/0.15)]' : 'text-ink/60 hover:text-ink',
                ]}
              >
                {LANG_LABEL[l]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- On small screens the nav gets its own row instead of hiding behind a menu button. -->
  <nav aria-label={t.menu} class="border-t border-black/5 sm:hidden">
    <ul class="wrap flex gap-5 overflow-x-auto text-[0.875rem] whitespace-nowrap [scrollbar-width:none]">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'tap transition-colors duration-200 hover:text-ink',
                isActive(item.href) ? 'font-medium text-ink' : 'text-ink/70',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
