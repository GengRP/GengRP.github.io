---
import { ui, LANGS, LANG_LABEL, HTML_LANG, DAILY_PATH, path, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  slug?: string;
}

const { lang, slug = '' } = Astro.props;
const t = ui[lang];
const current = Astro.url.pathname;

const items = [
  { label: t.nav.writing, href: path(lang, 'writing') },
  { label: t.nav.daily, href: DAILY_PATH[lang] },
  { label: t.nav.projects, href: path(lang, 'projects') },
  { label: t.nav.shelf, href: path(lang, 'shelf') },
  { label: t.nav.about, href: path(lang, 'about') },
];

const isActive = (href: string) => current.startsWith(href);
---

<header class="sticky top-0 z-30 border-b border-rule bg-paper/90 backdrop-blur">
  <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-5 py-3 sm:px-8">
    <a
      href={path(lang)}
      class="tap font-display text-lg font-bold tracking-tight text-ink transition-colors duration-200 hover:text-accent"
    >
      KOUHEI<span class="text-accent"> AI</span>
    </a>

    <div class="flex items-center gap-4">
      <ul class="hidden items-center gap-5 text-[0.9375rem] sm:flex" aria-label={t.menu}>
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'tap transition-colors duration-200 hover:text-accent',
                  isActive(item.href) ? 'font-medium text-ink' : 'text-muted',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <ul class="flex items-center gap-0.5 font-mono text-xs" aria-label={t.langs}>
        {
          LANGS.map((l) => (
            <li>
              <a
                href={path(l, slug)}
                hreflang={HTML_LANG[l]}
                lang={HTML_LANG[l]}
                aria-current={l === lang ? 'true' : undefined}
                class:list={[
                  'tap rounded px-1.5 py-1 transition-colors duration-200',
                  l === lang ? 'bg-ink text-paper' : 'text-faint hover:text-accent',
                ]}
              >
                {LANG_LABEL[l]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- On small screens the nav gets its own row instead of hiding behind a menu button. -->
  <nav aria-label={t.menu} class="border-t border-rule sm:hidden">
    <ul class="mx-auto flex max-w-3xl gap-5 overflow-x-auto px-5 text-[0.9375rem] whitespace-nowrap [scrollbar-width:none]">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'tap transition-colors duration-200 hover:text-accent',
                isActive(item.href) ? 'font-medium text-ink' : 'text-muted',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
