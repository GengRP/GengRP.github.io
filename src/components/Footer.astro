---
import site from '../content/site.json';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const email = site.profile.links.find((l) => l.label === 'Email');
---

<footer class="mx-auto mt-24 max-w-[1240px] px-5 pb-16 sm:px-8 lg:px-12">
  <div class="rule pt-8">
    <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="label mb-4 text-muted">{t.contact}</p>
        {
          email && (
            <a
              href={email.href}
              class="font-display text-[clamp(1.75rem,4vw,3rem)] leading-none tracking-tight transition-colors duration-200 hover:text-vermilion"
            >
              {email.href.replace('mailto:', '')}
            </a>
          )
        }
      </div>
      <ul class="flex flex-wrap gap-x-8 gap-y-3">
        {
          site.profile.links
            .filter((l) => l.label !== 'Email')
            .map((l) => (
              <li>
                <a
                  href={l.href}
                  rel="me noopener"
                  target="_blank"
                  class="label group inline-flex items-center gap-1.5 transition-colors duration-200 hover:text-vermilion"
                >
                  {l.label}
                  <span
                    aria-hidden="true"
                    class="inline-block transition-transform duration-200 group-hover:translate-x-0.5"
                  >
                    ↗
                  </span>
                </a>
              </li>
            ))
        }
      </ul>
    </div>
    <p class="rule-hair mt-10 pt-4 text-[0.6875rem] tracking-wide text-muted">
      © {new Date().getFullYear()} {site.profile.nameLatin} · {t.colophon}
    </p>
  </div>
</footer>
