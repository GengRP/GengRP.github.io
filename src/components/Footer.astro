---
import { ui, type Lang } from '../i18n/ui';
import site from '../content/site.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const live = site.elsewhere.filter((e) => e.href && !e.href.startsWith('mailto:'));
---

<footer class="bg-shade">
  <div class="wrap">
  <div class="flex flex-col gap-3 border-t border-rule py-8 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
    {t.footer && <p>{t.footer}</p>}
    <ul class="flex gap-5">
      {
        live.map((e) => (
          <li>
            <a href={e.href} class="tap transition-colors duration-200 hover:text-ink" rel="me">
              {e.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  </div>
</footer>
