---
import site from '../content/site.json';
import { ui, path, SHELVES, type Lang } from '../i18n/ui';
import Nav from './Nav.astro';
import Frame from './Frame.astro';
import SectionHead from './SectionHead.astro';
import Footer from './Footer.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const { profile, work, notes, library } = site;

const prose = lang === 'zh' ? 'prose-cn' : 'prose-en';
const headingFont = lang === 'zh' ? 'font-serif-cn' : 'font-display';
const shelfRatio = { reading: '2 / 3', watching: '2 / 3', listening: '1 / 1' } as const;
---

<Nav lang={lang} />

<main id="main" class="mx-auto max-w-[1240px] px-5 sm:px-8 lg:px-12">
  <!-- Masthead -->
  <header class="pt-10 pb-8 sm:pt-14">
    <h1
      class="font-display text-[clamp(2rem,7vw,5.5rem)] leading-[0.92] tracking-[-0.02em] break-words"
    >
      {profile.nameLatin}
    </h1>
    <p
      class="font-serif-cn mt-5 flex flex-wrap items-baseline gap-x-6 gap-y-2 text-[clamp(1.25rem,2.8vw,2.25rem)] leading-none font-light tracking-[0.28em] text-ink/80"
    >
      <span>{profile.nameCn}</span>
      <span aria-hidden="true" class="text-vermilion tracking-normal">·</span>
      <span lang="ja">{profile.nameJa}</span>
    </p>
  </header>

  <!-- Hero -->
  <section class="rule grid grid-cols-1 gap-x-10 gap-y-8 pt-8 md:grid-cols-12">
    <div class="md:col-span-3">
      <Frame
        lang={lang}
        ratioClass="aspect-[4/5] md:aspect-[2/3]"
        src={profile.portrait.src}
        alt={profile.portrait.alt[lang]}
      />
    </div>

    <div class="md:col-span-6">
      <p
        class:list={[
          'text-[clamp(1.35rem,2.6vw,2.1rem)] leading-[1.35] tracking-tight',
          headingFont,
          // Chinese serifs have no true italic — synthesised slant looks broken.
          lang === 'en' && 'italic leading-[1.25]',
        ]}
      >
        {profile.tagline[lang]}
      </p>
      <p class={`${prose} mt-6 max-w-[42ch] text-[0.95rem] text-ink/85`}>
        {profile.intro[lang]}
      </p>
    </div>

    <div class="md:col-span-3">
      <ul class="border-rule flex flex-row flex-wrap gap-x-8 gap-y-3 md:flex-col md:border-l md:pl-6">
        {
          profile.links.map((l) => (
            <li>
              <a
                href={l.href}
                rel="me noopener"
                target={l.href.startsWith('mailto:') ? undefined : '_blank'}
                class="label group inline-flex items-center gap-1.5 transition-colors duration-200 hover:text-vermilion"
              >
                {l.label}
                <span
                  aria-hidden="true"
                  class="inline-block text-vermilion opacity-0 transition-all duration-200 group-hover:translate-x-0.5 group-hover:opacity-100"
                >
                  ↗
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Work & Research -->
  <section class="mt-24">
    <SectionHead index="01" id="work" title={t.sections.work} />
    <ul class="mt-2">
      {
        work.map((item) => (
          <li>
            <a
              href={item.href}
              target="_blank"
              rel="noopener"
              class="rule-hair group grid grid-cols-1 gap-x-8 gap-y-2 py-6 transition-colors duration-200 hover:bg-tint/45 md:grid-cols-12"
            >
              <span class="label pt-1.5 text-muted md:col-span-2">{item.year}</span>
              <h3
                class={`${headingFont} text-[1.35rem] leading-snug tracking-tight transition-colors duration-200 group-hover:text-vermilion md:col-span-5`}
              >
                {item.title[lang]}
              </h3>
              <p class={`${prose} text-[0.9rem] text-muted md:col-span-4`}>{item.summary[lang]}</p>
              <span
                aria-hidden="true"
                class="text-vermilion transition-transform duration-200 group-hover:translate-x-1 md:col-span-1 md:justify-self-end md:pt-1"
              >
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Field Notes -->
  <section class="mt-24">
    <SectionHead index="02" id="notes" title={t.sections.notes} />
    <ul class="mt-8 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        notes.map((note) => (
          <li>
            <a href={note.href} target="_blank" rel="noopener" class="group block">
              <Frame
                lang={lang}
                ratio="3 / 2"
                src={note.image.src}
                alt={note.image.alt[lang]}
                class="transition-opacity duration-200 group-hover:opacity-90"
              />
              <p class="label mt-4 flex items-center gap-3 text-muted">
                <span>{note.date}</span>
                <span aria-hidden="true" class="bg-rule h-px flex-1" />
                <span class="text-vermilion">{note.source}</span>
              </p>
              <h3
                class={`${headingFont} mt-3 text-[1.2rem] leading-snug tracking-tight transition-colors duration-200 group-hover:text-vermilion`}
              >
                {note.title[lang]}
              </h3>
              <p class={`${prose} mt-2 text-[0.875rem] text-muted`}>{note.caption[lang]}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Reading / Watching / Listening -->
  <section class="mt-24">
    <SectionHead index="03" title={t.sections.currently} />
    <div class="mt-4">
      {
        SHELVES.map((shelf) => (
          <div class="rule-hair py-10">
            <div class="mb-6 flex items-baseline justify-between gap-6">
              <h3 class={`${headingFont} text-[1.5rem] tracking-tight`}>{t.shelf[shelf]}</h3>
              <a
                href={path(lang, shelf)}
                class="label group inline-flex items-center gap-1.5 text-muted transition-colors duration-200 hover:text-vermilion"
              >
                {t.viewAll}
                <span
                  aria-hidden="true"
                  class="inline-block transition-transform duration-200 group-hover:translate-x-0.5"
                >
                  →
                </span>
              </a>
            </div>
            <ul class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4">
              {library[shelf].slice(0, 4).map((entry) => (
                <li>
                  <Frame lang={lang} ratio={shelfRatio[shelf]} src={entry.cover.src} alt="" />
                  <p class={`${headingFont} mt-3 text-[0.95rem] leading-snug`}>
                    {entry.title[lang]}
                  </p>
                  <p class="label mt-1.5 text-muted">{entry.meta[lang]}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</main>

<Footer lang={lang} />
