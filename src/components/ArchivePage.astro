---
import site from '../content/site.json';
import { ui, path, type Lang, type Shelf } from '../i18n/ui';
import Nav from './Nav.astro';
import Frame from './Frame.astro';
import Footer from './Footer.astro';

interface Props {
  lang: Lang;
  shelf: Shelf;
}

const { lang, shelf } = Astro.props;
const t = ui[lang];
const entries = site.library[shelf];

const prose = lang === 'zh' ? 'prose-cn' : 'prose-en';
const headingFont = lang === 'zh' ? 'font-serif-cn' : 'font-display';
const ratio = shelf === 'listening' ? '1 / 1' : '2 / 3';
---

<Nav lang={lang} slug={shelf} />

<main id="main" class="mx-auto max-w-[1240px] px-5 sm:px-8 lg:px-12">
  <header class="pt-12 pb-8 sm:pt-16">
    {
      lang === 'zh' && (
        <p class="label mb-4 text-vermilion capitalize">{shelf}</p>
      )
    }
    <h1
      class:list={[
        'text-[clamp(2.5rem,9vw,7rem)] leading-[0.9] tracking-[-0.03em]',
        headingFont,
        lang === 'en' && 'capitalize',
      ]}
    >
      {t.shelf[shelf]}
    </h1>
    <div class="rule mt-6 flex flex-col gap-3 pt-4 sm:flex-row sm:items-baseline sm:justify-between">
      <p class={`${prose} max-w-[46ch] text-[0.95rem] text-muted`}>{t.shelfLead[shelf]}</p>
      <a
        href={path(lang)}
        class="label group inline-flex items-center gap-1.5 text-muted transition-colors duration-200 hover:text-vermilion"
      >
        <span
          aria-hidden="true"
          class="inline-block transition-transform duration-200 group-hover:-translate-x-0.5"
        >
          ←
        </span>
        {t.backHome}
      </a>
    </div>
  </header>

  <ul class="grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-3 lg:grid-cols-4">
    {
      entries.map((entry) => {
        const Tag = entry.href ? 'a' : 'div';
        return (
          <li>
            <Tag
              href={entry.href || undefined}
              target={entry.href ? '_blank' : undefined}
              rel={entry.href ? 'noopener' : undefined}
              class={entry.href ? 'group block' : 'block'}
            >
              <Frame
                lang={lang}
                ratio={ratio}
                src={entry.cover.src}
                alt=""
                class="transition-opacity duration-200 group-hover:opacity-90"
              />
              <p
                class={`${headingFont} mt-3 text-[1rem] leading-snug transition-colors duration-200 group-hover:text-vermilion`}
              >
                {entry.title[lang]}
              </p>
              <p class="label mt-1.5 text-muted">{entry.meta[lang]}</p>
            </Tag>
          </li>
        );
      })
    }
  </ul>
</main>

<Footer lang={lang} />
