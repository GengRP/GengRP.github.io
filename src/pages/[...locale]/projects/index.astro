---
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { ui, localePaths, type Lang } from '../../../i18n/ui';
import site from '../../../content/site.json';

export const getStaticPaths = localePaths;

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
---

<Base lang={lang} slug="projects" title={t.projects.title} description={t.projects.lead}>
  <h1 class="font-display text-3xl font-bold tracking-tight">{t.projects.title}</h1>
  <p class="mt-3 text-muted">{t.projects.lead}</p>
  <div class="mt-8 grid gap-4">
    {site.projects.map((p) => <ProjectCard lang={lang} project={p} />)}
  </div>
</Base>
