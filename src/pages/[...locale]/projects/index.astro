---
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import PageHero from '../../../components/PageHero.astro';
import { ui, localePaths, type Lang } from '../../../i18n/ui';
import site from '../../../content/site.json';

export const getStaticPaths = localePaths;

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
---

<Base lang={lang} slug="projects" title={t.projects.title} description={t.projects.lead}>
  <PageHero title={t.projects.title} lead={t.projects.lead} />
  <section class="band band-shade !pt-12 sm:!pt-16">
    <div class="wrap grid gap-5 sm:grid-cols-2">
      {site.projects.map((p) => <ProjectCard lang={lang} project={p} />)}
    </div>
  </section>
</Base>
