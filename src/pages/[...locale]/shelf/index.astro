---
import Base from '../../../layouts/Base.astro';
import SectionHead from '../../../components/SectionHead.astro';
import { ui, localePaths, type Lang } from '../../../i18n/ui';
import site from '../../../content/site.json';
// Generated daily from Apple Books by scripts/sync_books.py (agent workspace).
import books from '../../../content/books.json';

export const getStaticPaths = localePaths;

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];

type Book = { title: string; author: string; cover: string; date?: string };
const bookGroups: { key: string; title: string; items: Book[] }[] = [
  { key: 'reading', title: t.shelf.reading, items: books.reading },
  { key: 'finished', title: t.shelf.finished, items: books.finished },
];

const shelves = [{ key: 'films', title: t.shelf.films, items: site.shelf.films, aspect: 'aspect-[2/3]' }];

// Apple Music public playlist; edits in the app show up here without a rebuild.
const musicLang = { zh: 'zh-Hans-CN', ja: 'ja', en: 'en-US' }[lang];
const playlistSrc = `${site.shelf.playlist}?l=${musicLang}`;
---

<Base lang={lang} slug="shelf" title={t.shelf.title} description={t.shelf.lead}>
  <h1 class="font-display text-3xl font-bold tracking-tight">{t.shelf.title}</h1>
  <p class="mt-3 text-muted">{t.shelf.lead}</p>

  <section id="books" class="mt-12">
    <SectionHead title={t.shelf.books} />
    {
      bookGroups.map((g) => (
        <div class="mb-8">
          <h3 class="mb-4 text-sm font-medium text-muted">
            {g.title}
            <span class="ml-1 font-mono text-xs text-faint">{g.items.length}</span>
          </h3>
          {g.items.length === 0 ? (
            <p class="text-sm text-faint">{t.shelf.none}</p>
          ) : (
            <ul class="grid grid-cols-3 gap-x-4 gap-y-6 sm:grid-cols-6">
              {g.items.map((b) => (
                <li class="min-w-0">
                  <div class="aspect-[2/3] overflow-hidden rounded-md border border-rule bg-stone-100">
                    {b.cover ? (
                      <img src={b.cover} alt={b.title} loading="lazy" class="h-full w-full object-cover" />
                    ) : (
                      <div class="flex h-full items-center justify-center font-display text-2xl text-stone-300" aria-hidden="true">
                        {b.title.slice(0, 1)}
                      </div>
                    )}
                  </div>
                  <p class="mt-2 text-sm leading-snug font-medium break-words">{b.title}</p>
                  {b.author && <p class="mt-0.5 text-xs text-muted break-words">{b.author}</p>}
                  {b.date && <p class="mt-0.5 font-mono text-xs text-faint">{b.date}</p>}
                </li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </section>

  {
    shelves.map((s) => (
      <section id={s.key} class="mt-12">
        <SectionHead title={s.title} />
        <ul class="grid grid-cols-3 gap-x-4 gap-y-6 sm:grid-cols-6">
          {s.items.map((item) => {
            const Tag = item.href ? 'a' : 'div';
            return (
              <li class="min-w-0">
                <Tag href={item.href || undefined} class:list={['group block', item.href && 'cursor-pointer']}>
                  <div class:list={[s.aspect, 'overflow-hidden rounded-md border border-rule bg-stone-100']}>
                    {item.cover ? (
                      <img src={item.cover} alt="" loading="lazy" class="h-full w-full object-cover" />
                    ) : (
                      <div class="flex h-full items-center justify-center font-display text-2xl text-stone-300" aria-hidden="true">
                        {item.title[lang].slice(0, 1)}
                      </div>
                    )}
                  </div>
                  <p class="mt-2 text-sm leading-snug font-medium break-words transition-colors duration-200 group-hover:text-accent">
                    {item.title[lang]}
                  </p>
                </Tag>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }

  <section id="music" class="mt-12">
    <SectionHead title={t.shelf.music} />
    <iframe
      src={playlistSrc}
      title={t.shelf.music}
      loading="lazy"
      allow="autoplay *; encrypted-media *; clipboard-write"
      sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation"
      class="h-[450px] w-full overflow-hidden rounded-md border border-rule bg-transparent"
    ></iframe>
  </section>
</Base>
