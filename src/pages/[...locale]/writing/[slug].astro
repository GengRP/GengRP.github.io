---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { ui, LANGS, path, formatDate, type Lang } from '../../../i18n/ui';
import { getPosts } from '../../../i18n/posts';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) {
    for (const post of await getPosts(lang)) {
      paths.push({
        params: { locale: lang === 'zh' ? undefined : lang, slug: post.slug },
        props: { lang, post },
      });
    }
  }
  return paths;
}

const { lang, post } = Astro.props as { lang: Lang; post: Awaited<ReturnType<typeof getPosts>>[number] };
const t = ui[lang];
const { Content } = await render(post);
---

<Base lang={lang} slug={`writing/${post.slug}`} title={post.data.title} description={post.data.summary} type="article">
  <article class="wrap-narrow pt-10 pb-24 sm:pt-14">
    <a href={path(lang, 'writing')} class="tap text-sm text-accent hover:underline underline-offset-4">
      <span aria-hidden="true">‹</span> {t.writing.back}
    </a>
    <header class="mt-8 mb-12">
      <time datetime={post.data.date.toISOString()} class="text-sm font-medium text-muted">
        {formatDate(post.data.date, lang)}
      </time>
      <h1 class="display mt-3 text-4xl sm:text-5xl">{post.data.title}</h1>
      <p class="mt-5 text-xl leading-relaxed text-muted">{post.data.summary}</p>
    </header>
    <div class="prose" data-copy={t.writing.copy} data-copied={t.writing.copied}>
      <Content />
    </div>
    {
      post.data.syndication.length > 0 && (
        <p class="mt-16 border-t border-rule pt-6 text-sm text-muted">
          {t.writing.also}
          {post.data.syndication.map((s) => (
            <a href={s.href} class="link ml-2">
              {s.label}
            </a>
          ))}
        </p>
      )
    }
  </article>
</Base>

<script>
  // Copy button on every code block in an article.
  for (const body of document.querySelectorAll<HTMLElement>('.prose[data-copy]')) {
    const { copy = 'Copy', copied = 'Copied' } = body.dataset;
    for (const pre of body.querySelectorAll('pre')) {
      const wrap = document.createElement('div');
      wrap.className = 'code-wrap';
      pre.before(wrap);
      wrap.append(pre);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-btn';
      btn.textContent = copy;
      btn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(pre.innerText.trimEnd());
        btn.textContent = copied;
        btn.dataset.done = '';
        setTimeout(() => {
          btn.textContent = copy;
          delete btn.dataset.done;
        }, 1800);
      });
      wrap.append(btn);
    }
  }
</script>
