---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { ui, LANGS, path, formatDate, type Lang } from '../../../i18n/ui';
import { getPosts } from '../../../i18n/posts';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) {
    for (const post of await getPosts(lang)) {
      paths.push({
        params: { locale: lang === 'zh' ? undefined : lang, slug: post.slug },
        props: { lang, post },
      });
    }
  }
  return paths;
}

const { lang, post } = Astro.props as { lang: Lang; post: Awaited<ReturnType<typeof getPosts>>[number] };
const t = ui[lang];
const { Content } = await render(post);
---

<Base lang={lang} slug={`writing/${post.slug}`} title={post.data.title} description={post.data.summary} type="article">
  <article>
    <a href={path(lang, 'writing')} class="tap text-sm text-muted transition-colors duration-200 hover:text-accent">
      ← {t.writing.back}
    </a>
    <header class="mt-6 mb-10">
      <time datetime={post.data.date.toISOString()} class="font-mono text-xs text-faint">
        {formatDate(post.data.date, lang)}
      </time>
      <h1 class="mt-2 font-display text-3xl leading-tight font-bold tracking-tight text-balance">{post.data.title}</h1>
      <p class="mt-4 text-[1.0625rem] leading-relaxed text-muted">{post.data.summary}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    {
      post.data.syndication.length > 0 && (
        <p class="mt-12 border-t border-rule pt-5 text-sm text-faint">
          {t.writing.also}
          {post.data.syndication.map((s) => (
            <a href={s.href} class="link ml-2">
              {s.label}
            </a>
          ))}
        </p>
      )
    }
  </article>
</Base>
