---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { ui, localePaths, type Lang } from '../../../i18n/ui';
import { getPosts } from '../../../i18n/posts';

export const getStaticPaths = localePaths;

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const posts = await getPosts(lang);
---

<Base lang={lang} slug="writing" title={t.writing.title} description={t.writing.lead}>
  <h1 class="font-display text-3xl font-bold tracking-tight">{t.writing.title}</h1>
  <p class="mt-3 text-muted">{t.writing.lead}</p>
  <div class="mt-8">
    <PostList lang={lang} posts={posts} />
  </div>
</Base>
