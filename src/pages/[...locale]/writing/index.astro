---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import PageHero from '../../../components/PageHero.astro';
import { ui, localePaths, type Lang } from '../../../i18n/ui';
import { getPosts } from '../../../i18n/posts';

export const getStaticPaths = localePaths;

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const posts = await getPosts(lang);
---

<Base lang={lang} slug="writing" title={t.writing.title} description={t.writing.lead}>
  <PageHero title={t.writing.title} lead={t.writing.lead} />
  <section class="band band-shade !pt-12 sm:!pt-16">
    <div class="wrap-narrow">
      {
        posts.length ? (
          <PostList lang={lang} posts={posts} />
        ) : (
          <p class="card px-6 py-16 text-center text-lg text-muted">{t.writing.none}</p>
        )
      }
    </div>
  </section>
</Base>
