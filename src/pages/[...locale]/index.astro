---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import PostList from '../../components/PostList.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { ui, path, localePaths, DAILY_PATH, type Lang } from '../../i18n/ui';
import { getPosts, getShortPosts } from '../../i18n/posts';
import PostFeed from '../../components/PostFeed.astro';
import site from '../../content/site.json';

export const getStaticPaths = localePaths;

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const posts = (await getPosts(lang)).slice(0, 3);
const shortPosts = (await getShortPosts(lang)).slice(0, 2);
const { profile } = site;
---

<Base lang={lang} description={profile.tagline[lang]}>
  <section class="mb-14">
    <h1 class="font-display text-3xl leading-tight font-bold tracking-tight text-balance sm:text-4xl">
      {profile.tagline[lang]}
    </h1>
    <p class="mt-5 max-w-2xl text-[1.0625rem] leading-relaxed text-muted">{profile.intro[lang]}</p>
  </section>

  {
    posts.length > 0 && (
      <section class="mb-14">
        <SectionHead title={t.home.latest} href={path(lang, 'writing')} linkLabel={t.home.allWriting} />
        <PostList lang={lang} posts={posts} />
      </section>
    )
  }

  <section class="mb-14">
    <SectionHead title={t.home.latestPosts} href={path(lang, 'posts')} linkLabel={t.home.allPosts} />
    <PostFeed lang={lang} posts={shortPosts} />
  </section>

  <section class="mb-14">
    <a
      href={DAILY_PATH[lang]}
      class="group block cursor-pointer rounded-xl border border-rule bg-card p-6 transition-colors duration-200 hover:border-accent"
    >
      <p class="eyebrow">{t.home.daily}</p>
      <p class="mt-2 text-[1.0625rem] leading-relaxed">{t.home.dailyLead}</p>
      <p class="mt-3 text-sm font-medium text-accent">
        {t.home.dailyCta}
        <span class="ml-1 inline-block transition-transform duration-200 group-hover:translate-x-0.5">→</span>
      </p>
    </a>
  </section>

  <section class="mb-14">
    <SectionHead title={t.home.projects} href={path(lang, 'projects')} linkLabel={t.home.allProjects} />
    <div class="grid gap-4 sm:grid-cols-2">
      {site.projects.map((p) => <ProjectCard lang={lang} project={p} />)}
    </div>
  </section>

  <section>
    <SectionHead title={t.home.elsewhere} />
    <ul class="divide-y divide-rule">
      {
        site.elsewhere.map((e) => (
          <li class="flex items-baseline justify-between gap-4 py-3">
            <span class="flex items-baseline gap-3">
              {e.href ? (
                <a href={e.href} class="tap link font-medium" rel="me">
                  {e.label}
                </a>
              ) : (
                <span class="font-medium text-faint">{e.label}</span>
              )}
              <span class="text-sm text-faint">{e.note[lang]}</span>
            </span>
            {!e.href && <span class="shrink-0 text-xs text-faint">{t.soon}</span>}
          </li>
        ))
      }
    </ul>
  </section>
</Base>
