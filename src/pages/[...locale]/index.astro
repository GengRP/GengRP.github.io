---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import PostList from '../../components/PostList.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { ui, path, localePaths, DAILY_PATH, type Lang } from '../../i18n/ui';
import { getPosts, getShortPosts } from '../../i18n/posts';
import PostFeed from '../../components/PostFeed.astro';
import site from '../../content/site.json';

export const getStaticPaths = localePaths;

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const posts = (await getPosts(lang)).slice(0, 3);
const shortPosts = (await getShortPosts(lang)).slice(0, 2);
const { profile } = site;
---

<Base lang={lang} description={profile.tagline[lang]}>
  {
    posts.length > 0 && (
      <section class="band pt-12 sm:pt-16">
        <div class="wrap-narrow">
          <SectionHead title={t.home.latest} href={path(lang, 'writing')} linkLabel={t.home.allWriting} />
          <PostList lang={lang} posts={posts} />
        </div>
      </section>
    )
  }

  <section class="band band-shade">
    <div class="wrap-narrow">
      <SectionHead title={t.home.latestPosts} href={path(lang, 'posts')} linkLabel={t.home.allPosts} />
      <PostFeed lang={lang} posts={shortPosts} />
    </div>
  </section>

  <!-- AI daily: the one dark tile on the page. -->
  <section class="band">
    <div class="wrap">
      <a
        href={DAILY_PATH[lang]}
        class="group block cursor-pointer rounded-[2rem] bg-black px-8 py-16 text-center text-white transition-shadow duration-300 hover:shadow-[0_20px_60px_rgb(0_0_0/0.25)] sm:px-16 sm:py-24"
      >
        <h2 class="display text-4xl sm:text-6xl"><span class="gradient-text">{t.home.daily}</span></h2>
        <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/80 sm:text-xl">{t.home.dailyLead}</p>
        <p class="mt-8 inline-flex min-h-11 items-center rounded-full bg-white px-6 text-[0.9375rem] font-medium text-ink transition-colors duration-200 group-hover:bg-white/90">
          {t.home.dailyCta} <span class="ml-1" aria-hidden="true">›</span>
        </p>
      </a>
    </div>
  </section>

  <section class="band band-shade">
    <div class="wrap">
      <SectionHead title={t.home.projects} href={path(lang, 'projects')} linkLabel={t.home.allProjects} />
      <div class="grid gap-5 sm:grid-cols-2">
        {site.projects.map((p) => <ProjectCard lang={lang} project={p} />)}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap-narrow">
      <SectionHead title={t.home.elsewhere} />
      <ul class="card divide-y divide-rule/60 px-6 sm:px-8">
        {
          site.elsewhere.map((e) => (
            <li class="flex items-center justify-between gap-4 py-4">
              <span class="flex flex-wrap items-baseline gap-x-3">
                {e.href ? (
                  <a href={e.href} class="tap font-semibold text-ink transition-colors duration-200 hover:text-accent" rel="me">
                    {e.label}
                  </a>
                ) : (
                  <span class="font-semibold text-muted">{e.label}</span>
                )}
                <span class="text-sm text-muted">{e.note[lang]}</span>
              </span>
              {e.href ? (
                <span class="text-accent" aria-hidden="true">›</span>
              ) : (
                <span class="shrink-0 rounded-full bg-shade px-2.5 py-0.5 text-xs text-muted">{t.soon}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
