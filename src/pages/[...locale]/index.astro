---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import PostList from '../../components/PostList.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { ui, path, localePaths, DAILY_LATEST, type Lang } from '../../i18n/ui';
import { getPosts, getShortPosts } from '../../i18n/posts';
import PostFeed from '../../components/PostFeed.astro';
import site from '../../content/site.json';

export const getStaticPaths = localePaths;

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const posts = (await getPosts(lang)).slice(0, 3);
const shortPosts = (await getShortPosts(lang)).slice(0, 2);
const { profile } = site;
---

<Base lang={lang} description={profile.tagline[lang]}>
  {
    posts.length > 0 && (
      <section class="band pt-12 sm:pt-16">
        <div class="wrap-narrow">
          <SectionHead title={t.home.latest} href={path(lang, 'writing')} linkLabel={t.home.allWriting} />
          <PostList lang={lang} posts={posts} />
        </div>
      </section>
    )
  }

  <section class="band band-shade">
    <div class="wrap-narrow">
      <SectionHead title={t.home.latestPosts} href={path(lang, 'posts')} linkLabel={t.home.allPosts} />
      <PostFeed lang={lang} posts={shortPosts} />
    </div>
  </section>

  <!-- AI daily: a liquid-glass tile over soft color, opens the newest edition. -->
  <section class="band">
    <div class="wrap">
      <div class="daily-stage relative isolate overflow-hidden rounded-[2.5rem] px-4 py-10 sm:px-10 sm:py-16">
        <span class="blob blob-a" aria-hidden="true"></span>
        <span class="blob blob-b" aria-hidden="true"></span>
        <span class="blob blob-c" aria-hidden="true"></span>
        <a href={DAILY_LATEST[lang]} class="liquid-glass group mx-auto block max-w-3xl cursor-pointer rounded-[2rem] px-8 py-14 text-center sm:px-16 sm:py-20">
          <h2 class="display text-4xl text-ink sm:text-6xl">{t.home.daily}</h2>
          <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-ink/75 sm:text-xl">{t.home.dailyLead}</p>
          <p class="mt-8 inline-flex min-h-11 items-center rounded-full bg-ink px-6 text-[0.9375rem] font-medium text-white transition-colors duration-200 group-hover:bg-accent">
            {t.home.dailyCta} <span class="ml-1" aria-hidden="true">›</span>
          </p>
        </a>
      </div>
    </div>
  </section>

  <section class="band band-shade">
    <div class="wrap">
      <SectionHead title={t.home.projects} href={path(lang, 'projects')} linkLabel={t.home.allProjects} />
      <div class="grid gap-5 sm:grid-cols-2">
        {site.projects.map((p) => <ProjectCard lang={lang} project={p} />)}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap-narrow">
      <SectionHead title={t.home.elsewhere} />
      <ul class="card divide-y divide-rule/60 px-6 sm:px-8">
        {
          site.elsewhere.map((e) => (
            <li class="flex items-center justify-between gap-4 py-4">
              <span class="flex flex-wrap items-baseline gap-x-3">
                {e.href ? (
                  <a href={e.href} class="tap font-semibold text-ink transition-colors duration-200 hover:text-accent" rel="me">
                    {e.label}
                  </a>
                ) : (
                  <span class="font-semibold text-muted">{e.label}</span>
                )}
                <span class="text-sm text-muted">{e.note[lang]}</span>
              </span>
              {e.href ? (
                <span class="text-accent" aria-hidden="true">›</span>
              ) : (
                <span class="shrink-0 rounded-full bg-shade px-2.5 py-0.5 text-xs text-muted">{t.soon}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
