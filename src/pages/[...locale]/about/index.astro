---
import Base from '../../../layouts/Base.astro';
import { ui, localePaths, type Lang } from '../../../i18n/ui';
import site from '../../../content/site.json';
import SocialCards from '../../../components/SocialCards.astro';
import PageHero from '../../../components/PageHero.astro';

export const getStaticPaths = localePaths;

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const { about } = site;
---

<Base lang={lang} slug="about" title={t.about.title} description={site.profile.intro[lang]}>
  <PageHero title={t.about.title} />
  <section class="wrap pb-20 sm:pb-28">
    <div class="prose max-w-2xl text-lg sm:text-xl">
      {about.body[lang].map((para) => <p>{para}</p>)}
    </div>
  </section>
  <section class="band band-shade">
    <div class="wrap">
      <SocialCards lang={lang} />
    </div>
  </section>

</Base>
